<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WanderLust</title>
     <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
     <link
     rel="stylesheet"
     href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    />
     <link rel="stylesheet" href="/css/style.css"> 
</head>
<body>
     <%- include("../includes/navbar.ejs") %>
     <div class="container mt-4"> 
       <div class="row justify-content-center"> 
        <div class="col-md-8"></div>
    <h3> Edit your Listings</h3>
    <form method="POST" action="/listings/<%= listing._id %>?_method=PUT">

        <div class="mb-3">

             <label for="title" class="form-label">Title</label>
             <input type="text" name="listing[title]" id="" value="<%= listing.title %>" class="form-control">

        </div>

         <div class="mb-3"> 

            <label for="description" class="form-label">Description</label>
            <textarea name="listing[description]" type="text" id="" class="form-control"><%= listing.description %></textarea>

        </div>

        <div class="mb-3"> 

            <label for="image" class="form-label">Image</label>
            <input type="text" name="listing[image]" id=""  value="<%= listing.image %>" class="form-control">

        </div>


        <div class="row" > 

            <div class="mb-3 col-md-4"> 

               <label for="price" class="form-label">Price</label>   
               <input type="text" name="listing[price]" id=""  value="<%= listing.price %>" class="form-control">
         
           </div>

           <div class="mb-3 col-md-8"> 

              <label for="country" class="form-label">Country</label>
              <input type="text" name="listing[country]" id=""  value="<%= listing.country %>" class="form-control">

           </div>

        </div>


        <div class="mb-3"> 

            <label for="location" class="form-label">Location</label>
            <input type="text" name="listing[location]" id=""  value="<%= listing.location %>" class="form-control">

        </div>
        <button class="btn btn-dark edit-btn mt-3">Edit</button>
    </form>
    </div>
    </div>
     </div>

     <%- include("../includes/footer.ejs") %>



     <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>
    
</body>
</html>